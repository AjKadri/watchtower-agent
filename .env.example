# Example Base endpoint. The selected Compound investigation needs an archive-capable
# Base RPC for a complete result. Keep credentialed archive URLs only in .env.
BASE_RPC_URL=https://base-mainnet.public.blastapi.io

# Optional. The application will use this committed profile by default.
WATCHTOWER_CONFIG_PATH=config/target.json

# Optional local API and dashboard port.
PORT=3000
