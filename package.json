{
  "name": "watchtower-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --env-file-if-exists=.env --import tsx src/server/main.ts",
    "scan": "node --env-file-if-exists=.env dist/cli/scan.js",
    "scan:dev": "node --env-file-if-exists=.env --import tsx src/cli/scan.ts",
    "start": "node --env-file-if-exists=.env dist/server/main.js",
    "preinstall": "node scripts/check-runtime.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "express": "5.2.1",
    "typescript": "5.9.3",
    "viem": "2.55.19",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "tsx": "4.20.6",
    "vitest": "4.1.10"
  }
}
